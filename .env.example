# .env.example � real qiymatlarni .env ga yozing (bu fayl commit qilinadi)

BOT_TOKEN=your_telegram_bot_token_here
MAIN_ADMIN_ID=your_telegram_user_id
FRONTEND_URL=https://your-frontend-url.vercel.app
WEBHOOK_URL=https://your-bot-server.com

# CRM -> /send-notifications endpoint uchun maxfiy kalit.
# CRM bu kalitni "X-API-Key" header'da yuboradi. Uzun, tasodifiy qiymat qo'ying.
API_SECRET=change_me_to_a_long_random_secret

# Firebase Admin SDK key.
# 1-usul (lokal): serviceAccountKey.json faylini bot papkasiga qo'ying.
# Project Settings -> Service Accounts -> Generate new private key
FIREBASE_KEY_PATH=serviceAccountKey.json
# 2-usul (Render/hosting): fayl o'rniga butun JSON kontentni shu env-var ga joylang.
# FIREBASE_KEY_JSON={"type":"service_account","project_id":"...", ...}
